function(arena_core_apply_compiler_policy target_name)
  target_compile_features(${target_name} PRIVATE cxx_std_17)

  if(MSVC)
    target_compile_options(${target_name} PRIVATE /W4 /permissive- /Zc:__cplusplus)
    if(ARENA_WARNINGS_AS_ERRORS)
      target_compile_options(${target_name} PRIVATE /WX)
    endif()
  else()
    target_compile_options(${target_name} PRIVATE -Wall -Wextra -Wpedantic)
    if(ARENA_WARNINGS_AS_ERRORS)
      target_compile_options(${target_name} PRIVATE -Werror)
    endif()
  endif()

  if(ARENA_ENABLE_TSAN AND (ARENA_ENABLE_ASAN OR ARENA_ENABLE_UBSAN))
    message(FATAL_ERROR "ThreadSanitizer cannot be combined with AddressSanitizer/UndefinedBehaviorSanitizer")
  endif()

  if(ARENA_ENABLE_ASAN OR ARENA_ENABLE_UBSAN OR ARENA_ENABLE_TSAN)
    if(MSVC)
      message(FATAL_ERROR "Sanitizer presets are supported on the Linux GCC/Clang path")
    endif()

    set(arena_sanitizers "")
    if(ARENA_ENABLE_TSAN)
      list(APPEND arena_sanitizers "thread")
    endif()
    if(ARENA_ENABLE_ASAN)
      list(APPEND arena_sanitizers "address")
    endif()
    if(ARENA_ENABLE_UBSAN)
      list(APPEND arena_sanitizers "undefined")
    endif()
    list(JOIN arena_sanitizers "," arena_sanitizer_flags)
    target_compile_options(${target_name} PRIVATE -fno-omit-frame-pointer "-fsanitize=${arena_sanitizer_flags}")
    target_link_options(${target_name} PRIVATE "-fsanitize=${arena_sanitizer_flags}")
    if(ARENA_ENABLE_TSAN AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      # GCC reports Boost.Asio's portable fence wrapper as a TSan instrumentation limitation.
      # Keep the warning visible while allowing the instrumented binary to be built and executed.
      target_compile_options(${target_name} PRIVATE -Wno-error=tsan)
    endif()
  endif()
endfunction()
